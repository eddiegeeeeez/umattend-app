{
  "name": "umattend-app",
  "version": "1.0.0",
  "description": "UMAttend Application - Monorepo",
  "private": true,
  "scripts": {
    "dev": "node start-dev.js",
    "dev:concurrent": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --prefix \"[{name}]\" --names \"CLIENT,SERVER\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "build": "cd server && npm run build && cd ../client && npm run build",
    "start": "node start-prod.js",
    "start:concurrent": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --prefix \"[{name}]\" --names \"CLIENT,SERVER\" \"npm run start:client\" \"npm run start:server\"",
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm run prod"
  },
  "keywords": [
    "attendance",
    "university"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
