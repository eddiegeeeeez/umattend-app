# GitHub Actions Secrets Template
# Copy this to your GitHub repository secrets (Settings > Secrets and variables > Actions)

# =============================================
# SSH Configuration
# =============================================

SSH_PRIVATE_KEY=
# Your SSH private key for server access
# Generate with: ssh-keygen -t ed25519 -C "github-actions"
# Copy from: cat ~/.ssh/id_ed25519

SSH_PRIVATE_KEY_PASSPHRASE=
# Passphrase for SSH key (REQUIRED if your SSH key has a passphrase)
# Leave empty if your SSH key doesn't have a passphrase
# For security, it's recommended to use a passphrase-protected key

DEPLOY_HOST=
# Server IP address or hostname
# Example: 192.168.1.100 or server.example.com

DEPLOY_PORT=22
# SSH port (usually 22)

DEPLOY_USER=
# SSH username
# Example: ubuntu, root, or your custom user

# =============================================
# Application Paths
# =============================================

STAGING_APP_PATH=/var/www/umattend/staging
# Path on server for staging deployment
# Must be absolute path

PRODUCTION_APP_PATH=/var/www/umattend/production
# Path on server for production deployment
# Must be absolute path

# =============================================
# Domain Configuration
# =============================================

STAGING_DOMAIN=umattend-env-staging.vintasystem.com
# Staging domain name

PRODUCTION_DOMAIN=umattend.vintasystem.com
# Production domain name

LETSENCRYPT_EMAIL=admin@vintasystem.com
# Email for SSL certificate notifications

# =============================================
# Client Environment Files
# =============================================

CLIENT_STAGING_ENV_FILE=
# Content of client/.env.production for staging
# Example:
# NEXT_PUBLIC_API_URL=https://umattend-env-staging.vintasystem.com/api/v1
# NEXT_PUBLIC_FRONTEND_URL=https://umattend-env-staging.vintasystem.com

CLIENT_PRODUCTION_ENV_FILE=
# Content of client/.env.production for production
# Example:
# NEXT_PUBLIC_API_URL=https://umattend.vintasystem.com/api/v1
# NEXT_PUBLIC_FRONTEND_URL=https://umattend.vintasystem.com

# =============================================
# Server Environment Files
# =============================================

SERVER_STAGING_ENV_FILE=
# Content of server/.env for staging
# Example:
# NODE_ENV=production
# PORT=4000
# DATABASE_URL=postgresql://...
# DIRECT_URL=postgresql://...
# ALLOWED_ORIGINS=https://umattend-env-staging.vintasystem.com
# API_URL=https://umattend-env-staging.vintasystem.com/api/v1
# FRONTEND_URL=https://umattend-env-staging.vintasystem.com
# JWT_ACCESS_TOKEN_SECRET=your_secret_here
# JWT_ACCESS_TOKEN_TTL=3600
# JWT_REFRESH_TOKEN_SECRET=your_secret_here
# JWT_REFRESH_TOKEN_TTL=604800
# JWT_GOOGLE_STATE_SECRET=your_secret_here
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=https://umattend-env-staging.vintasystem.com/api/v1/auth/google/callback
# REDIS_HOST=your_redis_host
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_redis_password
# REDIS_PORT=12181
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=your_email@gmail.com
# MAIL_PASS=your_app_password

SERVER_PRODUCTION_ENV_FILE=
# Content of server/.env for production
# Same format as SERVER_STAGING_ENV_FILE but with production values

# =============================================
# Legacy/Optional Secrets (kept for compatibility)
# =============================================

APP_PATH_STAGING=/var/www/umattend/staging
# Alternative to STAGING_APP_PATH

APP_PATH_PRODUCTION=/var/www/umattend/production
# Alternative to PRODUCTION_APP_PATH

# =============================================
# Instructions
# =============================================

# 1. Generate SSH Key (on your local machine):
#    ssh-keygen -t ed25519 -C "github-actions-umattend"
#    When prompted for a passphrase, enter a strong passphrase (recommended)
#    
# 2. Copy public key to server:
#    ssh-copy-id -i ~/.ssh/id_ed25519.pub user@server
#    
# 3. Copy private key content:
#    cat ~/.ssh/id_ed25519
#    
# 4. Add secrets to GitHub:
#    Repository > Settings > Secrets and variables > Actions > New repository secret
#    
#    Important: Add SSH_PRIVATE_KEY_PASSPHRASE secret with your key's passphrase
#    
# 5. For multi-line secrets (like SSH keys and env files):
#    - Copy the entire content including BEGIN/END lines
#    - Paste directly into GitHub secret value field
#    
# 6. Test connection:
#    ssh -i ~/.ssh/id_ed25519 user@server "echo 'Connection successful'"

# =============================================
# Security Notes
# =============================================

# - Never commit this file with real values to git
# - Use strong, unique passwords and secrets
# - Rotate secrets regularly
# - Use separate secrets for staging and production
# - Limit SSH key access to deployment only
# - Consider using a dedicated deployment user
# - Enable 2FA on your GitHub account
# - Review GitHub Actions logs carefully for exposed secrets
