generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model user {
  id                  String          @id @default(cuid())
  google_id           String          @unique
  role                String
  last_login_at       DateTime?
  deleted_at          DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  done_onboarding     Boolean         @default(false)
  umindanao_email     String          @unique
  attendance_check_in attendance[]    @relation("CheckInByUser")
  attendance_check_ou attendance[]    @relation("CheckOutByUser")
  attendance          attendance[]
  events              events[]
  organizers          organizers[]
  refresh_tokens      refresh_token[]
  student             student?

  @@index([umindanao_email])
  @@index([role])
  @@index([created_at])
  @@index([last_login_at])
  @@index([deleted_at])
  @@map("users")
}

model student {
  id              String       @id @default(cuid())
  user_id         String       @unique
  student_id      Int          @unique
  department      String?
  program         String?
  profile_picture String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  name            String
  attendance      attendance[]
  user            user         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([program])
  @@index([student_id])
  @@map("students")
}

model refresh_token {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  ip_address String?
  device     String?
  is_active  Boolean   @default(true)
  revoked_at DateTime?
  expires_at DateTime
  last_used  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  browser    String?
  os         String?
  city       String?
  country    String?
  region     String?
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_active])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model events {
  id                 String       @id @default(cuid())
  title              String
  description        String
  department         String
  location           String
  all_day            Boolean      @default(false)
  start_time         DateTime?
  end_time           DateTime?
  is_done            Boolean      @default(false)
  form_fields        Json?
  created_by         String
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  check_out_required Boolean      @default(false)
  capacity           Int?
  attendance         attendance[]
  user               user         @relation(fields: [created_by], references: [id], onDelete: Cascade)
  organizers         organizers[]

  @@index([title])
  @@index([department])
  @@index([location])
  @@index([start_time])
  @@index([end_time])
  @@index([created_by])
  @@map("events")
}

model attendance {
  id                String    @id @default(cuid())
  event_id          String
  student_id        String
  check_in_at       DateTime  @default(now())
  check_out_at      DateTime?
  check_in_by       String
  check_out_by      String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  userId            String?
  check_in_by_user  user      @relation("CheckInByUser", fields: [check_in_by], references: [id], onDelete: Cascade)
  check_out_by_user user?     @relation("CheckOutByUser", fields: [check_out_by], references: [id], onDelete: Cascade)
  event             events    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  student           student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  user              user?     @relation(fields: [userId], references: [id])

  @@index([event_id])
  @@index([student_id])
  @@index([check_in_at])
  @@index([check_out_at])
  @@map("attendances")
}

model organizers {
  id         String   @id @default(cuid())
  user_id    String
  event_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  event      events   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
  @@index([user_id])
  @@index([event_id])
  @@map("organizers")
}
